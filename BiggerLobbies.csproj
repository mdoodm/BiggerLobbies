	<!-- Mono references: every game/Unity DLL in Managed, minus the runtime's own libraries
	     (netstandard2.1 supplies those). Nothing is copied to the output. -->
	<ItemGroup Condition="'$(Configuration)'=='Mono'">
		<Reference Include="$(ManagedPath)\*.dll"
		           Exclude="$(ManagedPath)\mscorlib.dll;$(ManagedPath)\netstandard.dll;$(ManagedPath)\System*.dll;$(ManagedPath)\Mono.*.dll;$(ManagedPath)\Microsoft.*.dll;$(ManagedPath)\Accessibility.dll;$(ManagedPath)\Novell.*.dll;$(ManagedPath)\Edgegap.dll"
		           Private="false" />
		<Reference Include="$(MelonLoaderPath)\MelonLoader.dll" Private="false" />
		<Reference Include="$(MelonLoaderPath)\0Harmony.dll" Private="false" />
		<!-- The Il2Cpp interop exposes private game members; on Mono the publicizer does the same. -->
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
		<Publicize Include="Assembly-CSharp;FishNet.Runtime;com.rlabrecque.steamworks.net" />
	</ItemGroup>
