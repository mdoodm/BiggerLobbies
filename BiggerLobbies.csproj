	<!-- Windows builds copy the DLL into Mods by default; SkipDeploy=true turns that off.
	     Deploy=true additionally force-closes the game first and relaunches it afterwards. -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipDeploy)' != 'true' and '$(OS)' == 'Windows_NT'">
		<Exec Condition="'$(Deploy)' == 'true'" Command="(tasklist | findstr /I &quot;Schedule.*I.exe&quot; &gt;nul &amp;&amp; taskkill /F /IM &quot;Schedule I.exe&quot; &amp;&amp; timeout /t 3 /nobreak &gt;nul) || echo Game not running" />
		<Exec Command="for /L %%i in (1,1,5) do (COPY &quot;$(TargetPath)&quot; &quot;$(ModsPath)&quot; &amp;&amp; goto copied || timeout /t 1 /nobreak &gt;nul)&#xD;&#xA;echo BiggerLobbies : warning BL001: couldn&apos;t copy to $(ModsPath) (is the game running?)&#xD;&#xA;:copied" />
		<Exec Condition="'$(Deploy)' == 'true'" Command="START &quot;&quot; &quot;$(GamePath)\Schedule I.exe&quot;" />
	</Target>
</Project>
