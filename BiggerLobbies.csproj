<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>BiggerLobbies</RootNamespace>
		<LangVersion>default</LangVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Configurations>Il2cpp;Mono</Configurations>
		<!-- Record source and PDB paths as /_/ so built DLLs don't contain the build machine's folders. -->
		<PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
	</PropertyGroup>

	<!-- Default game path only applies when -p:GamePath=... is not supplied -->
	<PropertyGroup Condition="'$(GamePath)'==''">
		<GamePath>D:\SteamLibrary\steamapps\common\Schedule I_public</GamePath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Il2cpp'">
		<ManagedPath>$(GamePath)\MelonLoader\Il2CppAssemblies</ManagedPath>
		<MelonLoaderPath>$(GamePath)\MelonLoader\net6</MelonLoaderPath>
		<ModsPath>$(GamePath)\Mods</ModsPath>
		<DefineConstants>IL2CPP</DefineConstants>
		<AssemblyName>BiggerLobbies_Il2cpp</AssemblyName>
	</PropertyGroup>

	<!-- Mono (alternate branch). GamePath must point at an install switched to the alternate branch.
	     The "_Mono" / "_Il2cpp" suffixes matter: keep them so each DLL names its backend. -->
	<PropertyGroup Condition="'$(Configuration)'=='Mono'">
		<TargetFramework>netstandard2.1</TargetFramework>
		<ManagedPath>$(GamePath)\Schedule I_Data\Managed</ManagedPath>
		<MelonLoaderPath>$(GamePath)\MelonLoader\net35</MelonLoaderPath>
		<ModsPath>$(GamePath)\Mods</ModsPath>
		<DefineConstants>MONO</DefineConstants>
		<AssemblyName>BiggerLobbies_Mono</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<UsePublicized>true</UsePublicized>
	</PropertyGroup>

